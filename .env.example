# Set in the product process environment. Agents inject these via the doorman.
EXA_API_KEY=
SERPER_API_KEY=
LINKUP_API_KEY=
OPENAI_API_KEY=

# FAST configures Research; SMART configures Answer. Empty reasoning omits the provider option.
SCRYRAVEN_FAST_MODEL=gpt-6-luna
SCRYRAVEN_FAST_REASONING=high
SCRYRAVEN_SMART_MODEL=gpt-6-sol
SCRYRAVEN_SMART_REASONING=medium
