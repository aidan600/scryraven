# Required API keys
OPENAI_API_KEY=<your_openai_api_key>
TAVILY_API_KEY=<your_tavily_api_key>
OPENROUTER_API_KEY=<your_openrouter_api_key>
LINKUP_API_KEY=<your_linkup_api_key>
EXA_API_KEY=<your_exa_api_key>

# Optional: lightweight scout search provider
# Free tier: 2000 queries/month
BRAVE_API_KEY=<your_brave_api_key>
SERPER_API_KEY=<your_serper_api_key>

# Optional: HTTP/SDK timeouts for search providers, in seconds.
# Defaults: Tavily/Linkup 30, Brave/Serper 8, Exa 30.
# TAVILY_SEARCH_TIMEOUT_SEC=30
# LINKUP_SEARCH_TIMEOUT_SEC=30
# BRAVE_SEARCH_TIMEOUT_SEC=8
# SERPER_SEARCH_TIMEOUT_SEC=8
# EXA_SEARCH_TIMEOUT_SEC=30

# Optional: CLI model/provider configuration.
# SCRYRAVEN_FAST_PROVIDER=OpenAI
# SCRYRAVEN_FAST_MODEL=gpt-5.4-mini
# SCRYRAVEN_SMART_PROVIDER=OpenAI
# SCRYRAVEN_SMART_MODEL=gpt-5.4
# SCRYRAVEN_EMBED_PROVIDER=OpenAI
# SCRYRAVEN_EMBED_MODEL=text-embedding-3-small
# SCRYRAVEN_LOCAL_URL=http://localhost:1234/v1

# Legacy PROPLEX_* aliases are temporarily supported as fallbacks.
